# Server
NODE_ENV=development
PORT=4000
PUBLIC_SITE_URL=https://aiforgermany.de

# API
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=60
NEWSLETTER_RATE_LIMIT_MAX_REQUESTS=5

# Consent and privacy
CONSENT_VERSION=2026-04-22
PRIVACY_POLICY_VERSION=2026-04-22

# Newsletter integration
# Keep disabled until a provider and double opt-in flow are configured.
NEWSLETTER_ENABLED=false
NEWSLETTER_PROVIDER=none

# Future OpenAI integration
# Never expose this key to Angular/browser code.
OPENAI_API_KEY=
