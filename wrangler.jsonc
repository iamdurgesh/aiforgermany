{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiforgermany",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "main": "./dist/server/server.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/browser",
    // Kanonische URLs ohne Trailing Slash (muss zu canonical/sitemap passen)
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
