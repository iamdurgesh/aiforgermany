{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiforgermany",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "main": "./dist/server/server.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/browser",
    // Kanonische URLs ohne Trailing Slash (muss zu canonical/sitemap passen)
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://aiforgermany.de",
    // 'none' bis der EU-Mail-Provider entschieden ist (TODO-QUESTION.md #3)
    "MAIL_PROVIDER": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiforgermany",
      // [AUSFÜLLEN] Nach `wrangler d1 create aiforgermany` die echte Id eintragen.
      // Wichtig: EU location hint wählen (TODO-QUESTION.md #2).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Retention-Job: täglich 03:00 UTC unbestätigte Leads (>30 Tage) löschen
    "crons": ["0 3 * * *"]
  }
}
